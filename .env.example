# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai-agent/*, /api/ai-tts).
# AI Studio / Cloud Run injects this at runtime from server secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this application is hosted (e.g. https://cvidyasolutions.com).
APP_URL="https://cvidyasolutions.com"

# NODE_ENV & PORT: Server runtime configuration (Port 3000 in development, Port 8080 or PORT in Cloud Run production).
NODE_ENV="production"
PORT="8080"

# ADMIN_AUTHORIZED_EMAILS: Comma-separated list of authorized Firebase Google accounts
# permitted to access the private /admin dashboard and administrative APIs.
# Note: Passcode-based admin login is permanently disabled. Only verified Google ID tokens
# matching this allowlist are accepted.
ADMIN_AUTHORIZED_EMAILS="cvidyasolutions@gmail.com,chiranjeevdas972@gmail.com"

# Optional SMTP settings for transactional lead and career email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your_smtp_email@example.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="no-reply@cvidyasolutions.com"

# Optional IndexNow key for instant search engine indexing
INDEXNOW_KEY="YOUR_INDEXNOW_VERIFICATION_KEY"
