{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "An official callback inquiry submitted by an onsite visitor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique inquiry reference ID." },
        "name": { "type": "string", "description": "Full name of the contact person." },
        "email": { "type": "string", "format": "email", "description": "Verified email address of the lead." },
        "phone": { "type": "string", "description": "Primary voice or messaging phone number." },
        "service": { "type": "string", "description": "The specific product module or general topic of inquiry." },
        "message": { "type": "string", "description": "Detailed organizational needs or requests." },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp of first submission." },
        "status": { "type": "string", "description": "Lifecycle status of the inquiry." }
      },
      "required": ["id", "name", "email", "phone", "service", "message", "timestamp", "status"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "A candidate job application submitted from the careers page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique application reference ID." },
        "name": { "type": "string", "description": "Full name of the applicant." },
        "email": { "type": "string", "format": "email", "description": "Email address of the applicant." },
        "phone": { "type": "string", "description": "Mobile phone number of the applicant." },
        "experience": { "type": "string", "description": "Applicant experience level (e.g., Student/Intern, Fresher, Junior, etc.)." },
        "message": { "type": "string", "description": "Motivation message or resume drive link." },
        "jobTitle": { "type": "string", "description": "The role/position applied for." },
        "jobCategory": { "type": "string", "description": "Role category (e.g., Software Development)." },
        "jobLocation": { "type": "string", "description": "Branch / campus location." },
        "roleType": { "type": "string", "description": "Employment type (e.g., Full-Time, Internship)." },
        "resumeFileName": { "type": "string", "description": "Uploaded resume document filename (e.g. PDF/DOCX)." },
        "resumeFileSize": { "type": "string", "description": "Size of uploaded resume document." },
        "resumeData": { "type": "string", "description": "Base64 or data URI payload of the uploaded resume document." },
        "resumeUrl": { "type": "string", "description": "Direct link or Google Drive URL for the resume." },
        "status": { "type": "string", "description": "Application review status." },
        "timestamp": { "type": "string", "description": "Timestamp of application submission." }
      },
      "required": ["name", "email", "phone", "jobTitle"]
    },
    "AppRegistration": {
      "title": "AppRegistration",
      "description": "User registration record for early access and downloading the mobile app.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the registrant." },
        "email": { "type": "string", "format": "email", "description": "Registrant email address." },
        "phone": { "type": "string", "description": "Registrant mobile phone number." },
        "platform": { "type": "string", "enum": ["android", "ios"], "description": "Selected mobile OS platform." },
        "privacyConsent": { "type": "boolean", "description": "Explicit privacy policy consent agreement." },
        "privacyPolicyVersion": { "type": "string", "description": "Version identifier of accepted privacy terms." },
        "status": { "type": "string", "description": "Registration state." },
        "clientTimestamp": { "type": "string", "description": "ISO timestamp recorded on client device." },
        "userAgent": { "type": "string", "description": "Client device user agent." }
      },
      "required": ["name", "email", "phone", "platform", "privacyConsent"]
    },
    "CallLog": {
      "title": "CallLog",
      "description": "AI Calling Console call simulation and qualification log.",
      "type": "object",
      "properties": {
        "callId": { "type": "string", "description": "Unique call session identifier." },
        "leadId": { "type": "string", "description": "Associated CRM inquiry/lead identifier." },
        "leadName": { "type": "string", "description": "Full name of the prospect or caller." },
        "phone": { "type": "string", "description": "Caller phone number." },
        "email": { "type": "string", "description": "Caller email address." },
        "companyName": { "type": "string", "description": "Company or institution name." },
        "city": { "type": "string", "description": "Caller city or location." },
        "direction": { "type": "string", "enum": ["Inbound", "Outbound"], "description": "Call direction." },
        "language": { "type": "string", "description": "Conversation language (English, Hindi, Hinglish)." },
        "voiceGender": { "type": "string", "enum": ["Female", "Male"], "description": "Selected voice persona." },
        "productInterest": { "type": "string", "description": "Primary C Vidya product or service discussed." },
        "intent": { "type": "string", "description": "Detected caller intent." },
        "outcome": { "type": "string", "description": "Final call outcome status." },
        "leadPriority": { "type": "string", "enum": ["Hot", "Warm", "Cold"], "description": "Lead qualification temperature." },
        "assignedDepartment": { "type": "string", "description": "Assigned follow-up department." },
        "durationSeconds": { "type": "number", "description": "Total duration of the call in seconds." },
        "summary": { "type": "string", "description": "Executive summary of the call." },
        "nextAction": { "type": "string", "description": "Recommended next follow-up action." },
        "nextFollowUpAt": { "type": "string", "description": "Scheduled follow-up timestamp or window." },
        "recordingConsent": { "type": "boolean", "description": "Whether caller consented to call logging." },
        "dncRequested": { "type": "boolean", "description": "Whether caller requested Do-Not-Call." },
        "timestamp": { "type": "string", "description": "ISO 8601 timestamp of the call." }
      },
      "required": ["callId", "leadName", "phone", "direction", "outcome", "timestamp"]
    },
    "DemoBooking": {
      "title": "DemoBooking",
      "description": "Scheduled product demonstration booking from CRM or AI Calling Console.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "description": "Unique demo booking ID." },
        "leadId": { "type": "string", "description": "Associated CRM lead ID." },
        "leadName": { "type": "string", "description": "Prospect full name." },
        "phone": { "type": "string", "description": "Prospect phone number." },
        "email": { "type": "string", "description": "Prospect email address." },
        "companyName": { "type": "string", "description": "Company or institution name." },
        "product": { "type": "string", "description": "Selected software product for demonstration." },
        "preferredDate": { "type": "string", "description": "Scheduled demo date." },
        "preferredTimeSlot": { "type": "string", "description": "Scheduled demo time slot." },
        "meetingMode": { "type": "string", "description": "Meeting delivery channel (Google Meet, Zoom, WhatsApp, Phone)." },
        "assignedExecutive": { "type": "string", "description": "Assigned specialist or sales executive." },
        "status": { "type": "string", "description": "Demo lifecycle status (Scheduled, Completed, Rescheduled, No-Show)." },
        "notes": { "type": "string", "description": "Preparation notes or custom requirements." },
        "createdAt": { "type": "string", "description": "ISO 8601 creation timestamp." }
      },
      "required": ["bookingId", "leadName", "phone", "product", "preferredDate", "preferredTimeSlot", "status", "createdAt"]
    },
    "HandoffTicket": {
      "title": "HandoffTicket",
      "description": "Human specialist escalation ticket created from AI Calling or Support workflows.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "description": "Unique escalation ticket ID." },
        "callId": { "type": "string", "description": "Originating call session ID." },
        "leadName": { "type": "string", "description": "Customer or caller name." },
        "phone": { "type": "string", "description": "Customer phone number." },
        "reason": { "type": "string", "description": "Escalation reason and context." },
        "urgency": { "type": "string", "enum": ["Immediate", "High", "Normal"], "description": "Escalation urgency." },
        "targetDepartment": { "type": "string", "description": "Target department (Sales, Support, HR, Founder Desk)." },
        "assignedAgent": { "type": "string", "description": "Assigned specialist name." },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"], "description": "Ticket resolution status." },
        "createdAt": { "type": "string", "description": "ISO 8601 creation timestamp." }
      },
      "required": ["ticketId", "leadName", "phone", "reason", "urgency", "targetDepartment", "status", "createdAt"]
    }
  },
  "firestore": {
    "inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "A collection containing all onsite consultation leads and callback submissions."
    },
    "job_applications/{jobApplicationId}": {
      "schema": "JobApplication",
      "description": "A collection containing all career job applications and resume submissions."
    },
    "app_download_registrations/{regId}": {
      "schema": "AppRegistration",
      "description": "A collection containing verified mobile app download registrations and early access requests."
    },
    "call_logs/{callId}": {
      "schema": "CallLog",
      "description": "A collection containing AI calling session logs, transcripts, and qualification outcomes."
    },
    "demo_bookings/{bookingId}": {
      "schema": "DemoBooking",
      "description": "A collection containing scheduled software demonstration bookings."
    },
    "handoff_tickets/{ticketId}": {
      "schema": "HandoffTicket",
      "description": "A collection containing human specialist escalation tickets."
    }
  }
}
