rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to validate inquiry structure
    function isValidInquiry(data) {
      return data != null
        && 'name' in data && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && 'email' in data && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && 'phone' in data && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50;
    }

    // Helper to validate job application structure
    function isValidApplication(data) {
      return data != null
        && 'name' in data && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && 'email' in data && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && 'phone' in data && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && 'jobTitle' in data && data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 200;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Inquiries collection for customer callback submissions
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read: if true;
      allow update, delete: if false;
    }

    // Job applications collection for careers submissions
    match /job_applications/{jobApplicationId} {
      allow create: if isValidApplication(request.resource.data);
      allow read: if true;
      allow update, delete: if false;
    }
  }
}

