rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "chiranjeevdas972@gmail.com";
    }

    function isValidInquiry(data) {
      return data != null
        && 'name' in data && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && 'email' in data && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && (!('status' in data) || data.status in ["New", "New Lead", "Pending Callback", "registered", "Forwarded to cvidyasolutions@gmail.com"])
        && !('isAdmin' in data) && !('admin' in data);
    }

    function isValidApplication(data) {
      return data != null
        && 'name' in data && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && 'email' in data && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && 'jobTitle' in data && data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 200
        && (!('resumeData' in data) || (data.resumeData is string && data.resumeData.size() <= 800000))
        && !('isAdmin' in data) && !('admin' in data);
    }

    function isValidAppRegistration(data) {
      return data != null
        && 'name' in data && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && 'email' in data && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && 'platform' in data && data.platform is string && (data.platform == "android" || data.platform == "ios")
        && 'privacyConsent' in data && data.privacyConsent == true
        && !('isAdmin' in data) && !('admin' in data);
    }

    function isValidAdminVaultRecord(data, adminId) {
      return data != null
        && data.keys().hasAll(['uid', 'email', 'passwordHash', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'passwordHash', 'updatedAt'])
        && data.uid is string && data.uid == adminId && data.uid == request.auth.uid
        && data.email is string && data.email == "chiranjeevdas972@gmail.com"
        && data.passwordHash is string && data.passwordHash.size() == 64 && data.passwordHash.matches('^[a-f0-9]{64}$')
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCallLog(data) {
      return data != null
        && 'callId' in data && data.callId is string && data.callId.size() >= 2 && data.callId.size() <= 128
        && 'leadName' in data && data.leadName is string && data.leadName.size() >= 2 && data.leadName.size() <= 150
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && 'direction' in data && data.direction is string && (data.direction == "Inbound" || data.direction == "Outbound")
        && 'outcome' in data && data.outcome is string && data.outcome.size() >= 2 && data.outcome.size() <= 100
        && 'timestamp' in data && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 64;
    }

    function isValidDemoBooking(data) {
      return data != null
        && 'bookingId' in data && data.bookingId is string && data.bookingId.size() >= 2 && data.bookingId.size() <= 128
        && 'leadName' in data && data.leadName is string && data.leadName.size() >= 2 && data.leadName.size() <= 150
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && 'product' in data && data.product is string && data.product.size() >= 2 && data.product.size() <= 200
        && 'preferredDate' in data && data.preferredDate is string && data.preferredDate.size() >= 4 && data.preferredDate.size() <= 50
        && 'preferredTimeSlot' in data && data.preferredTimeSlot is string && data.preferredTimeSlot.size() >= 2 && data.preferredTimeSlot.size() <= 100
        && 'status' in data && data.status is string && data.status.size() >= 2 && data.status.size() <= 60
        && 'createdAt' in data && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidHandoffTicket(data) {
      return data != null
        && 'ticketId' in data && data.ticketId is string && data.ticketId.size() >= 2 && data.ticketId.size() <= 128
        && 'leadName' in data && data.leadName is string && data.leadName.size() >= 2 && data.leadName.size() <= 150
        && 'phone' in data && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && 'reason' in data && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 2000
        && 'urgency' in data && data.urgency is string && (data.urgency == "Immediate" || data.urgency == "High" || data.urgency == "Normal")
        && 'targetDepartment' in data && data.targetDepartment is string && data.targetDepartment.size() >= 2 && data.targetDepartment.size() <= 100
        && 'status' in data && data.status is string && (data.status == "Open" || data.status == "In Progress" || data.status == "Resolved")
        && 'createdAt' in data && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidDeploymentRegistry(data, productId) {
      return data != null
        && data.keys().hasOnly(['productId', 'legacyId', 'name', 'category', 'hostingPlatform', 'githubRepository', 'branch', 'environment', 'deploymentUrl', 'version', 'commitSha', 'buildId', 'deploymentStatus', 'enabled', 'connectedToAutoDeploy', 'deployedBy', 'lastDeploymentAt', 'updatedAt', 'badge', 'failureAlert', 'lastFailedAt', 'lastFailureReason', 'adminLockedDisabled', 'notes'])
        && 'productId' in data && data.productId is string && data.productId == productId
        && 'legacyId' in data && data.legacyId is string && data.legacyId.size() >= 1 && data.legacyId.size() <= 64
        && 'name' in data && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && 'category' in data && (data.category == "software" || data.category == "ai-agent")
        && 'hostingPlatform' in data && (data.hostingPlatform == "cloudflare-workers" || data.hostingPlatform == "cloudflare-pages")
        && 'deploymentStatus' in data && (data.deploymentStatus == "active" || data.deploymentStatus == "inactive" || data.deploymentStatus == "failed" || data.deploymentStatus == "coming-soon")
        && 'enabled' in data && data.enabled is bool
        && (!('deploymentUrl' in data) || (data.deploymentUrl is string && data.deploymentUrl.size() <= 500))
        && 'updatedAt' in data && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64
        && !('isAdmin' in data) && !('admin' in data);
    }

    function isValidDeploymentHistory(data, entryId) {
      return data != null
        && data.keys().hasOnly(['id', 'productId', 'version', 'commitSha', 'buildId', 'deploymentUrl', 'hostingPlatform', 'githubRepository', 'branch', 'environment', 'status', 'deployedBy', 'deployedAt', 'message'])
        && 'id' in data && data.id is string && data.id == entryId
        && 'productId' in data && data.productId is string && data.productId.size() >= 2 && data.productId.size() <= 128
        && 'buildId' in data && data.buildId is string && data.buildId.size() >= 1 && data.buildId.size() <= 120
        && 'status' in data && (data.status == "success" || data.status == "failed")
        && 'deployedAt' in data && data.deployedAt is string && data.deployedAt.size() >= 10 && data.deployedAt.size() <= 64;
    }

    function isValidDeploymentAuditLog(data, logId) {
      return data != null
        && data.keys().hasOnly(['id', 'action', 'productId', 'actor', 'timestamp', 'details'])
        && 'id' in data && data.id is string && data.id == logId
        && 'action' in data && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && 'productId' in data && data.productId is string && data.productId.size() >= 2 && data.productId.size() <= 128
        && 'actor' in data && data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 120
        && 'timestamp' in data && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 64
        && 'details' in data && data.details is string && data.details.size() >= 1 && data.details.size() <= 500;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() && isValidId(adminId) && request.auth.uid == adminId;
      allow create, update: if isAdmin() && isValidId(adminId) && request.auth.uid == adminId && isValidAdminVaultRecord(request.resource.data, adminId);
      allow delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /job_applications/{jobApplicationId} {
      allow create: if isValidId(jobApplicationId) && isValidApplication(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidApplication(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /app_download_registrations/{regId} {
      allow create: if isValidId(regId) && isValidAppRegistration(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /call_logs/{callId} {
      allow create: if isValidId(callId) && isValidCallLog(request.resource.data) && isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /demo_bookings/{bookingId} {
      allow create: if isValidId(bookingId) && isValidDemoBooking(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /handoff_tickets/{ticketId} {
      allow create: if isValidId(ticketId) && isValidHandoffTicket(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /cvidya_deployment_registry/{productId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(productId) && isValidDeploymentRegistry(request.resource.data, productId);
      allow delete: if false;
    }

    match /cvidya_deployment_history/{entryId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(entryId) && isValidDeploymentHistory(request.resource.data, entryId);
      allow delete: if false;
    }

    match /cvidya_deployment_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidDeploymentAuditLog(request.resource.data, logId);
      allow update, delete: if false;
    }
  }
}
